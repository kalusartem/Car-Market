# Copy to /etc/car-market.env (chmod 600). These are the same public values as in .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SITE_URL=https://car-market.duckdns.org
PORT=8787
HOST=127.0.0.1
# "Listing waiting for approval" emails (SMTP over implicit TLS, e.g. Brevo smtp-relay.brevo.com:465).
# Without them the notice is only logged. NOTIFY_TO defaults to kalusartem@gmail.com; NOTIFY_FROM to NOTIFY_TO.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=
